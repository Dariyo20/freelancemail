# Environment Variables

# MongoDB Connection
MONGODB_URI=

# Resend (email sending)
RESEND_API_KEY=
FROM_EMAIL=dave@striat.dev
# Display name shown to recipients ("Dave Ariyo <dave@striat.dev>")
FROM_NAME=Dave Ariyo

# Alert notifications (warm lead / referral alerts)
ALERT_EMAIL=dave@striat.dev

# Server Configuration
PORT=3000
NODE_ENV=development

# Anthropic API (per-lead AI personalization for [CUSTOM_LINE] in initial emails)
# If unset, custom_line silently stays empty and emails render without the hook line.
ANTHROPIC_API_KEY=

# Optional: API Keys for future features
# GROQ_API_KEY=your-groq-api-key
# GEMINI_API_KEY=your-gemini-api-key
